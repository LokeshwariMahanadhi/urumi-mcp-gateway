# Copy this file to .env and fill it in. NEVER commit .env.

# Gateway database (docker compose in db/)
POSTGRES_PASSWORD=change-me

# WooCommerce store (local)
WOOCOMMERCE_URL=http://127.0.0.1:8081
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me

# Dashboard sessions and chat tokens: long random strings
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
CHAT_GATEWAY_SECRET=replace-with-another-long-random-string

# Hosts the gateway may call even though they are private (comma separated)
ALLOWED_UPSTREAM_HOSTS=127.0.0.1

# Chat agent: any OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
